#!/bin/bash
#
# Stand-in for the `claude` CLI, used by the tests. Files in the folder named
# by the FAKE_CLAUDE_STATE file next to this script control what it does:
#   mode       serve (default), consent, untrusted, loggedout, crash, ignore-int,
#              renew-warning (serves, then warns it cannot renew its sign-in),
#              auth-401 (stops the way claude does when its sign-in ran out)
#   loggedout  if present, `claude auth status` reports signed out
#   capacity   what the status block shows as capacity (default 0/32)
#   session    if present, a serving fake runs one session child process with
#              a state file in $CLAUDE_CONFIG_DIR/sessions, like the real CLI
#   events     what it did, one line per event: "<pid> <event>"
# Like the real CLI, a serving fake redraws its status block several times a
# second, using escape codes, even when its output is not a terminal.

here=$(cd "$(dirname "$0")" && pwd -P)
state=$(cat "$here/FAKE_CLAUDE_STATE" 2>/dev/null) || state="$here/state"
mkdir -p "$state"

event() { printf '%s %s\n' "$$" "$*" >>"$state/events"; }

case "${1-}" in
  --version)
    echo "9.9.9 (Fake Claude)"
    ;;
  auth)
    if [ -e "$state/loggedout" ]; then
      printf '{\n  "loggedIn": false\n}\n'
      exit 1
    fi
    printf '{\n  "loggedIn": true,\n  "authMethod": "claude.ai"\n}\n'
    ;;
  remote-control)
    shift
    mode=$(cat "$state/mode" 2>/dev/null || echo serve)
    event "start mode=$mode args=$* cwd=$PWD"
    case "$mode" in
      consent) echo "Enable Remote Control? (y/n)"; exit 0 ;;
      untrusted) echo "Error: Workspace not trusted. Run claude in this folder once first."; exit 1 ;;
      loggedout) echo "Error: You must be logged in to use Remote Control."; exit 1 ;;
      crash) echo "fake claude: crashing"; exit 3 ;;
      auth-401) echo "Error: Poll: Authentication failed (401)"; exit 1 ;;
      ignore-int) trap 'event "ignored SIGINT"' INT ;;
      *) trap 'event "got SIGINT"; exit 130' INT ;;
    esac
    trap 'event "got SIGTERM"; exit 143' TERM
    if [ -e "$state/session" ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
      (while :; do sleep 1; done) &
      kid=$!
      trap 'kill "$kid" 2>/dev/null' EXIT
      mkdir -p "$CLAUDE_CONFIG_DIR/sessions"
      printf '{"pid":%s,"name":"fake-session","bridgeSessionId":"session_fakekid%s","status":"busy","statusUpdatedAt":%s000}\n' \
        "$kid" "$kid" "$(date +%s)" >"$CLAUDE_CONFIG_DIR/sessions/$kid.json"
    fi
    echo "Take this session with you and pick up right where you left off on any device."
    frame() {
      printf '\302\267\342\234\224\357\270\216\302\267 Connected \302\267 fake\n'
      printf '    Capacity: %s \302\267 New sessions will be created in the current directory\n' \
        "$(cat "$state/capacity" 2>/dev/null || echo 0/32)"
      printf '    \033]8;;https://claude.ai/code/session_fake%s?from=cli\007fake-session\033]8;;\007\n' "$$"
      printf '\nContinue coding in the Claude mobile app or https://claude.ai/code?environment=env_fake%s\n' "$$"
    }
    frame
    n=0
    while :; do
      sleep 0.2
      n=$((n + 1))
      if [ "$mode" = renew-warning ] && [ "$n" = 5 ]; then
        printf '\033[5A\033[J'
        echo "Remote Control could not renew this computer's connection: claude.ai did not accept the sign-in it uses. Run \`claude /login\` to sign in again. The connection keeps working for about 26 hours; if it still cannot sign in then, it stops."
      else
        printf '\033[5A\033[J'
      fi
      frame
    done
    ;;
  *)
    echo "fake claude: unsupported arguments: $*" >&2
    exit 2
    ;;
esac
